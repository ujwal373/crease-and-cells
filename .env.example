# Copy to .env for local overrides. Never commit .env.
# Production values go in Railway environment variables.

# SQLite file path. Use a Railway volume path in production, e.g. /data/game.db
CC_DB_PATH=game.db

# Allowed origins for CORS. JSON array or comma-separated.
# Set to your production frontend URL after deploy.
CC_CORS_ORIGINS=["http://localhost:5173"]

# Anthropic API key — enables live Tutor hints. Omit to use static fallback hints.
# NEVER put this in frontend code. Backend only.
# ANTHROPIC_API_KEY=sk-ant-...

# Trace output file (default: logs/trace.jsonl)
# CC_TRACE=logs/trace.jsonl

# Tutor model (default: claude-haiku-5-5)
# CC_TUTOR_MODEL=claude-haiku-5-5

# Daily spend cap in USD (default: 1.00)
# CC_DAILY_BUDGET_USD=1.00

# Max hints per player per day (default: 5)
# CC_DAILY_PLAYER_CAP=5
